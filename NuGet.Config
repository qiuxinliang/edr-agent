<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Release lock files are generated and verified against the public NuGet
    v3 feed.  Do not inherit runner-specific fallback or offline feeds: their
    package bytes can make a locked restore non-reproducible.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
