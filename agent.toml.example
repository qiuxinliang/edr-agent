# 与《EDR 端点详细设计 v1.0》§11.1 对齐 — 复制为 agent.toml 后按需修改
#
# 使用说明、HTTPS/TLS 采集与控制面、SQLite 队列与环境变量：见同目录 README.md
# 与平台 REST 联调时的 `endpoint_id` / `tenant_id` / `rest_base_url` 语义与启动 [config] WARN：见 docs/WP3_CONFIG_VALIDATION.md
# HTTPS/TLS 传输、`EDR_EVENT_INGEST_SPLIT`、ingest 排障：见 docs/WP4_HTTP_TRANSPORT_OPS.md
# 规则母版 → 预处理 TOML / P0 IR / 版本对账（WP-5）：见 docs/WP5_RULES_ENGINEERING.md；TOML 子串规则：见 docs/PREPROCESS_RULES.md
# 批处理/上送先量化后调优（WP-6）：见 docs/WP6_TRANSPORT_BATCH_QUANTIFIED_OPS.md
# 离线队列、失败落盘与出队重试/退避（WP-7）：见 docs/WP7_OFFLINE_QUEUE_RETRY.md
# ETW/采集 profile 与 P0 字段矩阵底线（WP-8）：见 docs/WP8_ETW_COLLECTION_PROFILE.md、config/profiles/wp8_compliance_baseline.env.example

[server]
# 保留为证书和历史 server_addr 兼容字段；当前通信主路径使用 [platform].rest_base_url。
address              = ""
ca_cert              = "C:\\Program Files\\FDSecurity\\certs\\ca.pem"
client_cert          = "C:\\Program Files\\FDSecurity\\certs\\client.pem"
client_key           = "C:\\Program Files\\FDSecurity\\certs\\client-key.pem"
client_key_provider  = "pem" # pem | cng | tpm | pkcs11
client_cert_store    = ""
client_cert_thumbprint = ""
pkcs11_module        = ""
pkcs11_key_uri       = ""
tpm_key_uri          = ""
connect_timeout_s    = 10
keepalive_interval_s = 30

[agent]
endpoint_id          = "auto"
tenant_id            = "tenant_default"

# §19 攻击面：GET_ATTACK_SURFACE 采集后 POST 至平台（需 PATH 中有 curl）。endpoint_id 不可为 auto。
# [platform]
# rest_base_url      = "https://edr.example.com/api/v1"
# rest_user_id       = "edr-agent"
# rest_bearer_token  = "" # 安装器会从 enroll 响应写入 Agent 专用 bearer；不要填平台管理员 JWT
# http2_enabled      = false # 商业默认 HTTPS/1.1；HTTP/2 仅在灰度策略中开启
# http2_require      = false # 保持 false；仅特定网络验证达标后才考虑强制 h2
# control_http2_enabled = false # 控制面独立开关；未配置时兼容继承 http2_enabled
# control_http2_require = false
# control_http1_fallback = true
# control_stream_enabled = true
# long_poll_fallback = true
# report_events_v2_enabled = true # protobuf envelope；失败默认不回退旧 JSON/base64，避免网络异常时双发
# data_plane_encoding = "protobuf"
# data_plane_compression = "identity" # zstd 字典能力由服务端灰度后再开启
# control_dict_version = "edr-zstd-dict-v1"
# control_schema_version = "edr-control-schema-v1"
# control_profile_id = "default-http1-protobuf"
# qos_dscp           = "AF21"
# telemetry_threshold = "medium"
# telemetry_sampling_pct = 100
# backpressure_enabled = true
# proxy_mode         = "auto" # auto | off | explicit
# proxy_url          = ""     # http://proxy.corp:8080
# relay_url          = ""     # https://relay.corp:443/api/v1
# [platform.request_signing]
# enabled = false              # enroll 返回 request_signing_enabled 后置 true；旧平台/旧 Agent 保持 false
# key_id = ""                  # enroll 响应 request_signing_key_id
# secret = ""                  # enroll 响应 request_signing_secret；生产安装器应限制本文件 ACL

# §19.8 攻击面 TOML（与《EDR_端点详细设计》§19.8 对齐；**成功 POST 最小间隔** = min(port,service,policy,full)；ETW/按需刷新/周期共享；enabled 默认 false）。
# 快照 JSON 的 collectedAt 为 **UTC**（...Z），与「本地时区显示」需自行换算。
# [attack_surface]
# enabled                  = false
# port_interval_s          = 7200
# conn_interval_s          = 300
# service_interval_s       = 7200
# policy_interval_s        = 7200
# full_snapshot_interval_s = 7200
# outbound_top_n           = 128
# outbound_exclude_loopback = true
# geoip_db_path            = "/opt/edr/data/GeoLite2-City.mmdb"
# high_risk_immediate_ports = [23, 445, 3389, 6379, 27017, 1433, 3306]
# firewall_rule_detail_max = 500
# §19.10：TCPIP/WFAS ETW 命中后，经预处理打标、主线程去抖触发 POST 攻击面快照
# etw_refresh_triggers_snapshot = true
# etw_refresh_debounce_s        = 8

[collection]
# WP-8：可观测 profile / 与 P0 会签的边界 — docs/WP8_ETW_COLLECTION_PROFILE.md；合规基线 env 见 config/profiles/wp8_compliance_baseline.env.example
etw_enabled          = true
# Windows A4.3 + §19.10：各可选 Provider 独立开关。Kernel-Process/File/Net/Reg 为 mandatory 不可关。
#
# ===== 高噪 Provider：默认关闭，按需打开（与安全团队会签后） =====
# DNS Client：事件量极大（1000+/s），非 DNS 隧道检测场景建议保持关闭
etw_dns_client_provider   = false
# WMI Activity：事件量中-高，多数 P0 规则不依赖 WMI 原始事件
etw_wmi_provider          = false
# TCPIP：事件量极大，仅攻击面检测需要；关闭不影响进程/文件/网络核心采集
etw_tcpip_provider        = false
# WFAS 防火墙：事件量中-高，仅攻击面检测需要
etw_firewall_provider     = false
#
# ===== 推荐保留的 Provider =====
# PowerShell：脚本类 P0 规则依赖，量中低，建议保留
etw_powershell_provider   = true
# Security Audit（4624/4688 等）：登录、进程创建审计，合规基线建议保留
etw_security_audit_provider = true
#
adaptive_enabled = true
adaptive_boost_seconds = 180
adaptive_min_severity = 3
#
ebpf_enabled         = true
# Linux：auditd 采集 execve/connect/openat/rename/unlink/chmod/chown/setuid/ptrace/module load。
# 需要 auditd 已启用并授予读取 audit.log 的权限；eBPF 作为后续内核直连采集路径，健康度会独立上报 loaded 状态。
# eBPF 联调可设置 EDR_LINUX_EBPF_TRACE_PIPE=1 读取 trace_pipe 中外部 BPF 程序输出的 execve/connect/openat 等事件。
auditd_enabled       = false
auditd_log_path      = "/var/log/audit/audit.log"
poll_interval_s      = 1
max_event_queue_size = 1024
# Windows 实时 ETW 会话：每缓冲大小（KB）与刷写周期（秒）；0=默认 64/1。亦可 EDR_ETW_BUFFER_KB / EDR_ETW_FLUSH_TIMER_S（见 README · A4.2）
# etw_buffer_kb        = 64
# 降低 ETW 刷写频率以减少回调 CPU 开销；默认 3s（与延迟折中，安全敏感服务器可调回 1）
etw_flush_timer_s    = 3

[preprocessing]
# 去重窗口：90s（关闭高噪 Provider 后事件量大幅下降，可适当放宽以保留更多行为特征）
# 高频阈值：30/秒/PID（高于此值视为突刺，触发限流）
dedup_window_s       = 90
high_freq_threshold  = 30
sampling_rate_whitelist = 0.02
# 端上默认丢弃「ETW1 非可打印、仅 parse=failed 无有效 reg/file/网络等」槽位；对拍时设 EDR_PREPROCESS_ALLOW_UNPARSED_NET_EVENTS=1 或 true/yes
# WP-2：总线背压、L2/L3、进程门控的实验室/生产档与验收 — docs/WP2_EVENT_BUS_PREPROCESS.md；config/profiles/wp2_*.env.example
# L2/L3 首版（默认关闭）通过环境变量控制：
#   EDR_PREPROCESS_L2_SPLIT=1                # 启用“未命中规则事件”的抽样保留
#   EDR_PREPROCESS_L2_KEEP_RATIO=0.03        # 未命中规则保留比例（0~1，默认取 sampling_rate_whitelist）
#   EDR_PREPROCESS_L3_PRESSURE=1             # 启用总线高压分流
#   EDR_PREPROCESS_L3_HIGH_PCT=80            # 进入高压模式阈值
#   EDR_PREPROCESS_L3_RECOVER_PCT=60         # 退出高压模式阈值（滞回）
#   EDR_PREPROCESS_L3_DROP_PERMILLE=900      # 高压下低价值事件丢弃千分比（0~1000）
#   EDR_PREPROCESS_PROCNAME_GATE=1           # B方案：仅对 process_create 做“规则进程名门控”降载（默认开启；设0可关闭）
#   EDR_PREPROCESS_PROCNAME_GATE_KEEP_UNKNOWN_PERMILLE=30
#                                          # 非门控进程名保留千分比（默认30=3%）；告警判定仍走完整规则
#   EDR_PREPROCESS_STRICT_BEHAVIOR_GATE=1    # 严格前置门控：仅 PROCESS_CREATE/PROCESS_INJECT 进入后续处理（用于压测验证）
# 内置默认动态规则版本（与平台 `dynamic_rules_v1.json` 对齐）
rules_version = "edr-dynamic-rules-v1-r283-0f17fb98"
# 若本文件未显式配置 [[preprocessing.rules]]，Agent 会尝试从与 agent.toml 同目录的
# agent_preprocess_rules_v1.toml 自动加载第一版动态前置规则（可用 EDR_PREPROCESS_RULES_BUNDLE_PATH 覆盖路径）。

[detection_policy]
# 服务端下发的 suppression / allowlist 策略。Agent 会把本节映射到检测引擎的运行策略，
# 并在 suppression 命中时写入 policy_version / source / audit_id，避免依赖裸环境变量漂移。
source = "server"
audit_id = "change-approval-or-policy-id"
policy_version = "det-pol-2026.05.example"
rollback_version = ""
fp_policy_version = "fp-pol-2026.05.example"
fp_rollback_version = ""
rmm_policy_version = "rmm-pol-2026.05.example"
rmm_rollback_version = ""
allow_paths = ""
script_dirs = ""
management_tools = "anydesk,teamviewer,rustdesk,screenconnect,connectwise,splashtop,meshcentral,atera,psexec,paexec"
# fp_feedback：服务端把告警标记 false_positive 后自动生成的条件化 suppression 规则编译成的平铺 token
# （进程名/路径/命令行子串，逗号分隔）。Agent 映射到 EDR_DETECTION_FP_FEEDBACK，命中即降级/丢弃同类事件。
# 通常由 runtime-policy.toml 下发，无需手填；留空表示无服务端 FP 抑制。
fp_feedback = ""

# 二期进阶：条件化 suppression（AND 语义，比 fp_feedback 平铺匹配更精确）。通常由 runtime-policy.toml
# 下发，无需手填。仅当 process_name 命中且 contains_all 全部出现时才抑制，因此能保留同一进程其它形态
# （如外链 / 非 localhost）的告警能力。action = downgrade（降级）| drop（丢弃）。
# [[detection_policy.suppression]]
# target_rule_id = "R-LOLBIN-002"
# process_name = "rundll32.exe"
# contains_all = ["davclnt.dll,DavSetCookie", "localhost"]
# action = "downgrade"
# reason = "auto_fp_R-LOLBIN-002"

# 可选：见 docs/PREPROCESS_RULES.md — 在 dedup/限流 之前匹配，action = drop | emit_always
# [[preprocessing.rules]]
# name = "drop_temp_exe"
# action = "drop"
# exe_path_contains = "\\Windows\\Temp\\"
# icase_exe_path = true

# 配置热载（可选）：设置环境变量 EDR_CONFIG_RELOAD_S 为正整数秒，则主循环周期性检测本文件 mtime，
# 变更后重载 preprocessing / resource / self_protect / 攻击面调度及 AVE 的规则与行为启发式配置。
# 吊销、L4 联动、SQLite 路径等 [ave] 项在扫描时从内存配置读取，热载后即可生效。
[ave]
# 静态检测由签名 IOC、哈希/证书白名单和规则引擎完成；行为检测由本地启发式链完成。
scan_threads         = 2
max_file_size_mb     = 256
sensitivity          = "MEDIUM"
# Windows Authenticode：WinVerifyTrust 吊销链（WTD_REVOKE_WHOLECHAIN）。可被环境变量 EDR_AVE_CERT_REVOCATION=0/1 覆盖。
# cert_revocation_check = false
# 与 AVE_ScanFileWithSubject(subject_pid) 配合：行为异常分 ≥ 阈值时可叠加 L4（rule_name=behavior_realtime）。环境变量 EDR_AVE_L4_BEHAVIOR_LINK=0/1 可覆盖开关。
# l4_realtime_behavior_link = false
# l4_realtime_anomaly_threshold = 0.65
# L3 IOC 先于 L2 哈希白名单匹配；为 false 时仍会在规则扫描结束后核对 IOC。
# ioc_precheck_enabled = true
# 行为管线消费线程（AVE_StartBehaviorMonitor）；生产默认关闭，P0 阶段不由远程策略自动开启。
# behavior_monitor_enabled = false
# 可选 SQLite：空路径表示禁用该层（详见 docs/AVE_ENGINE_IMPLEMENTATION_PLAN.md）
# file_whitelist_db_path = ""
# ioc_db_path = ""
# behavior_policy_db_path = ""
# cert_whitelist_db_path = ""
# cert_whitelist_enabled = true

# 批次/上送：先采 shutdown 指标再调 `batch_*`、发送队列等 —见 docs/WP6_TRANSPORT_BATCH_QUANTIFIED_OPS.md
[upload]
batch_max_events     = 200
batch_max_size_mb    = 2
batch_timeout_s      = 2
max_upload_mbps      = 1

# 须与 EDR_PERSIST_STRATEGY / EDR_PERSIST_QUEUE / EDR_QUEUE_* 一起理解，见 docs/WP7_OFFLINE_QUEUE_RETRY.md
[offline]
queue_db_path        = "C:\\Program Files\\FDSecurity\\queue\\edr_queue.db"
max_queue_size_mb    = 512
retention_hours      = 72
evidence_cache_path  = "C:\\Program Files\\FDSecurity\\evidence\\local_evidence_cache.db"
evidence_cache_max_size_mb = 128
evidence_cache_retention_hours = 72

[resource_limit]
profile              = "workstation"
cpu_limit_percent    = 1
memory_limit_mb      = 100
emergency_cpu_limit  = 5
pmfe_scans_per_min   = 3
webshell_scan_mb_per_min = 64
shellcode_packets_per_sec = 2000
low_priority_keep_percent_under_pressure = 5

[logging]
level                = "info"
log_dir              = "C:\\Program Files\\FDSecurity\\logs"
max_log_size_mb      = 100
max_log_files        = 10

# §8 高危指令（kill / isolate / forensic）：默认关闭；亦可由环境变量 EDR_CMD_ENABLED=1 开启
# [command]
# allow_dangerous      = false
# allow_rtq_readonly   = true
# signing_public_key_path = "C:\\Program Files\\FDSecurity\\certs\\command-signing.pub.pem"

# §9 自保护：防调试、事件总线背压告警、可选 Windows Job Object
# [self_protect]
# anti_debug                      = false
# job_object_windows              = false
# watchdog_log_interval_s         = 0
# event_bus_pressure_warn_pct     = 90
# # §B1 进程内子系统心跳：collector/preprocess/main_loop 超过该秒数未跳动则判 hang 并告警；0=关
# subsystem_stale_timeout_s       = 0
# # §B2 伴生 watchdog 进程互守（抗 kill）：true 时 agent 启动独立 watchdog 子进程，
# #     任一被杀由另一方按原 config 重新拉起；干净退出写 stop stamp 阻止复活。
# #     环境变量 EDR_SELF_PROTECT_WATCHDOG_PROCESS=1 亦可开启。
# watchdog_process                = false
# watchdog_heartbeat_interval_s   = 5      # agent 写/ watchdog 读心跳文件间隔（秒）
# watchdog_stale_timeout_s        = 30     # 心跳超过该秒数视为僵死并重启
# watchdog_max_restarts_per_min   = 5      # 重启风暴防护；超限退避
# watchdog_heartbeat_path         = ""     # 空=从 EDR_SELF_PROTECT_PIDFILE 旁派生或用临时目录
#
# Windows 签名白名单（Stage0）可通过环境变量补充可信厂商关键词（逗号分隔，大小写不敏感）：
#   EDR_AVE_TRUSTED_VENDOR_KEYWORDS="tencent,aliyun,huawei,qihoo,360,total defense,kingsoft,beijing huorong,"
#   "sangfor,dbappsecurity,venustech,topsec,nsfocus,beyondtrust,citrix,zoom,slack,notion,microsoft,google,mozilla,"
#   "adobe,oracle,intel,amd,nvidia,apple,dell,lenovo,hp,ibm,sap"
# 建议：先在灰度环境按你们资产画像裁剪，再全量推广。

# §16 取证 YARA 扫描规则库。yara_scan 规则来源优先级：命令内联 rules > forensic_yara_rules_dir > EDR_YARA_RULES_DIR > rules/forensic。
# Windows 安装包默认随包放置到 C:\\Program Files\\FDSecurity\\rules\\forensic；开发态可使用相对路径 rules/forensic。
[command]
forensic_yara_rules_dir = "rules/forensic"

# §17 协议层 Shellcode 检测（Windows x64；需管理员）。默认关闭。
# 官方签名 WinDivert.dll/WinDivert64.sys 随安装包置于 Agent 目录，首次启用时由 WinDivert 按需安装驱动；旧版 System32 部署仅作兼容回退。
[shellcode_detector]
enabled                  = false
windivert_priority       = -1000
max_payload_inspect      = 16384
alert_threshold          = 0.70
auto_isolate_threshold   = 0.95
auto_isolate_execute     = false
heuristic_score_scale    = 1.0
pmfe_followup_enabled    = true
pmfe_heuristic_threshold = 0.90
# P0 优化 #2：每条连接只深扫前 N 字节载荷（漏洞利用特征在会话起始）；超过则跳过深扫。0=不限（旧行为）。
flow_scan_first_bytes    = 65536
# 方向感知TCP重组：总内存达到上限时淘汰最久未活动的流。
reassembly_max_flows     = 512
reassembly_memory_limit_kb = 16384
reassembly_idle_timeout_s = 30
# P0 优化 #3：是否深扫 TLS 应用数据（密文）。默认 false：仅取 ClientHello(JA3/SNI)，跳过密文记录，省 CPU 且免误报。
scan_tls_appdata         = false
# 排除 Agent 自身到平台/中继/代理的流量(默认 true)。启动解析 [platform] rest_base_url/relay_url/proxy_url 的 IP，
# 在 WinDivert 内核过滤器加 not 子句，避免「EDR 自抓自」。平台 IP 变更需重启重新解析。
exclude_self_traffic     = true
# YARA 规则目录周期性热重载间隔（秒）；0=仅启动时加载。生产建议 300。
yara_rules_reload_interval_s = 300
monitor_smb              = true
monitor_rdp              = true
monitor_winrm            = true
monitor_msrpc            = true
monitor_ldap             = true
# 异步检测 worker 数(1..4)。捕获固定使用单线程；worker 消费有界队列，YARA 匹配与热重载由锁保护。
detector_threads         = 2
scan_queue_capacity      = 256
# P2 #8：WinDivert 内核队列参数(0=用内置默认)。瘦终端可调小以约束非分页内存。
# 范围:length 32..16384、size 64..32768 KiB、time 100..16000 ms。
windivert_queue_length   = 8192
windivert_queue_size_kb  = 8192
windivert_queue_time_ms  = 2000
# 已知漏洞 YARA 规则目录（命中优先于内置匹配器）。开发态相对路径；
# 安装包由安装器写入部署机绝对路径（如 <install>/rules/shellcode）。
# 留空则跳过 YARA，仅用内置匹配器。
yara_rules_dir           = "src/shellcode_detector/rules"
forensic_dir             = ""
forensic_save_pcap       = false
evidence_preview_bytes   = 0
forensic_ring_slots      = 0
forensic_ring_max_packet_bytes = 2048
windivert_tcp_ports      = ""
#   空 = 内置 SMB/RDP/WinRM/MSRPC/LDAP 等端口；非空 = 仅监听所列 TCP 端口（逗号分隔），并忽略 monitor_smb 等按类开关

# 端侧网络扇出/扫描检测：同进程在窗口内对同一目的端口连接大量不同 IP=端口/主机扫描或横向探测(T1046/T1018)。
# 用端侧真实 dst_ip/dst_port(服务端只拿到占位值,故必须端侧做)。默认关。env: EDR_NET_FANOUT_ENABLE/WINDOW_S/THRESHOLD/PORTS。
[net_fanout]
enabled                  = false
window_s                 = 120
distinct_ip_threshold    = 50
# 扫描敏感端口(逗号分隔);留空=内置默认 445,139,3389,22,135,5985,1433,3306,23,5432
ports                    = ""

# §18 Webshell 检测引擎（Linux 当前支持 inotify 目录监控；可通过 EDR_WEBSHELL_ROOTS 指定站点根目录）
[webshell_detector]
enabled                  = false
discovery_interval_s     = 1800
iis_config_path          = ""
max_watch_dirs           = 64
monitor_subdirs          = true
webshell_rules_dir       = "src/webshell_detector/rules"
scan_threads             = 2
max_file_size_mb         = 10
defer_retry_ms           = 1000
alert_threshold          = 0.50
l2_review_threshold      = 0.80
upload_webshell_files    = true
upload_timeout_s         = 60
max_upload_size_mb       = 10

# =========================
# [detection] 检测引擎自适应策略
# 控制 shellcode / webshell / PMFE 的启停模式。
# =========================
[detection]
# Agent 启动时探测环境（端口/服务）并按策略自动启用引擎
auto_profile = true
# shellcode 检测: 0=强制关 1=强制开 -1=自适应（保守探测）
shellcode_mode = 0
# webshell 检测: 0=强制关 1=强制开 -1=自适应（Web 根目录/IIS 配置探测）
webshell_mode = 0
# PMFE 内存取证: 0=强制关 1=仅空闲扫描 2=关键告警触发单进程扫描 -1=自适应关键告警触发
pmfe_mode = 2

# =========================
# [pmfe] PMFE 空闲内存取证扫描
# 在 CPU 空闲时针对有网络活动的系统服务进程做 VAD 深度扫描。
# =========================
[pmfe]
# 启用空闲扫描
idle_scan_enabled = false
# 扫描间隔（分钟）
idle_scan_interval_min = 15
# 单轮最多扫描进程数
idle_scan_max_procs = 8
# CPU 低于此百分比才启动扫描
idle_cpu_threshold = 15.0
# 笔记本电池模式跳过
idle_skip_on_battery = true

# =========================
# [forensic_auto] 取证自动触发策略
# 当 P0 事件或指定 MITRE 技术命中时，自动触发取证收集。
# =========================
[forensic_auto]
enabled = false
cooldown_s = 30
max_per_hour = 20
max_concurrent = 2
per_mitre_cooldown_s = 300
trigger_on_p0 = true
trigger_on_detection = true
collect_process_tree = true
collect_network_state = true
collect_autoruns = true
collector_timeout_s = 300
# 留空则使用本机默认目录；也可用 EDR_FORENSIC_OUTPUT_DIR 覆盖
collector_output_dir = ""
# 留空则由 [platform].rest_base_url 推导；也可用 EDR_FORENSIC_UPLOAD_URL 覆盖
collector_upload_url = ""
trigger_on_mitre = ["T1059", "T1547", "T1543", "T1003"]

# =========================
# [health_monitor] Agent 健康监测
# 默认开启基础健康上报；终端管理详情页可按主机调整 profile/TTL。
# =========================
[health_monitor]
enabled = true
profile = "basic"
interval_s = 60
expires_at_unix_ms = 0
request_id = "agent-bootstrap"

# =========================
# [shell] 远程 Shell 会话配置
# =========================
[shell]
max_sessions = 3
session_timeout_s = 600
max_output_per_command_kb = 1024

# =========================
# [detection] 检测引擎自适应策略
# 控制 shellcode / webshell / PMFE 的启停模式。
# =========================
# [detection]
# # Agent 启动时探测环境（端口/服务）并按策略自动启用引擎
# auto_profile = true
# # shellcode 检测: -1=自适应 0=关 1=开（默认 -1）
# shellcode_mode = -1
# # webshell 检测: -1=自适应 0=关 1=开（默认 -1）
# webshell_mode = -1
# # PMFE 内存取证: 0=关 1=仅空闲扫描 (默认 0)
# pmfe_mode = 0

# =========================
# [pmfe] PMFE 空闲内存取证扫描
# 在 CPU 空闲时针对有网络活动的系统服务进程做 VAD 深度扫描。
# =========================
# [pmfe]
# # 启用空闲扫描
# idle_scan_enabled = false
# # 扫描间隔（分钟）
# idle_scan_interval_min = 15
# # 单轮最多扫描进程数
# idle_scan_max_procs = 8
# # CPU 低于此百分比才启动扫描
# idle_cpu_threshold = 15.0
# # 笔记本电池模式跳过
# idle_skip_on_battery = true

# =========================
# [remote] 远程配置拉取
# Agent 定时向平台轮询拉取最新的预处理规则/运行时策略（TOML）与 P0 加密规则包。
# 若配置了本 section，将覆盖 EDR_REMOTE_CONFIG_URL / EDR_REMOTE_CONFIG_POLL_S / EDR_REMOTE_P0_BUNDLE_URL 环境变量。
# =========================
[remote]
# 平台 REST API 地址：
# - 预处理规则：GET /api/v1/agent/rules.toml
# - 运维中心检测/自动取证策略：GET /api/v1/agent/runtime-policy.toml
rules_url = "http://192.168.1.10:8080/api/v1/agent/rules.toml"

# P0 加密规则包拉取地址（对应 GET /api/v1/agent/p0-bundle.enc）
p0_bundle_url = "http://192.168.1.10:8080/api/v1/agent/p0-bundle.enc"

# 轮询间隔秒数（>=5，推荐 30）
poll_interval_s = 30

# Agent 自更新: 版本清单地址（GET 返回 JSON: {version, sha256, ...}）
# version_url = "http://192.168.1.10:8080/api/v1/agent/version"
# Agent 自更新: 二进制下载地址
# download_url = "http://192.168.1.10:8080/api/v1/agent/download/latest"
# 是否启用自更新（默认 false）
# auto_update = true
