<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FDSecuritySetupUI</AssemblyName>
    <RootNamespace>EDRAgent.SetupUi</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <!--
      The Windows build callers set RuntimeIdentifier as an MSBuild global
      property (not with `dotnet -r`).  It is therefore available while this
      project is evaluated and selects the immutable lock closure before
      NuGet starts restore.  This avoids a late RID injection accidentally
      falling back to the portable packages.lock.json graph.
    -->
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' == ''">packages.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' == 'win-x64'">packages.win-x64.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' == 'win-arm64'">packages.win-arm64.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\installer.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateSetupUiRuntimeIdentifier" BeforeTargets="Restore"
          Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'win-arm64'">
    <Error Text="Unsupported Setup UI RuntimeIdentifier '$(RuntimeIdentifier)'. Supported values are win-x64 and win-arm64." />
  </Target>
</Project>
