<Window x:Class="EDRAgent.SetupUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="EDR Agent Setup"
        Width="840"
        Height="580"
        MinWidth="840"
        MinHeight="580"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#070A12">
  <Grid Background="#070A12">
    <wv2:WebView2 x:Name="Browser" />
    <Grid x:Name="LoadingPanel" Background="#070A12">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="EDR Agent"
                   Foreground="#FFFFFF"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />
        <TextBlock x:Name="LoadingText"
                   Text="正在加载安装向导..."
                   Foreground="#7B8A9A"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18" />
        <ProgressBar Width="220"
                     Height="4"
                     IsIndeterminate="True"
                     Foreground="#4D7CFF"
                     Background="#141B29"
                     BorderThickness="0" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
