{
  "schema": "edr.windows-rule-audit.v1",
  "scope": "inert matcher inputs; context_required hits are signals, not confirmed attacks; no commands execute",
  "cases": [
    {
      "case_id": "authorized_smb",
      "rule_id": "R-LMOVE-001",
      "expect_match": true,
      "scope": "context_required",
      "event": {
        "event_type": "network_connect",
        "process_name": "explorer.exe",
        "dest_port": 445,
        "dest_ip": "10.1.2.3"
      }
    },
    {
      "case_id": "authorized_rdp",
      "rule_id": "R-LMOVE-002",
      "expect_match": true,
      "scope": "context_required",
      "event": {
        "event_type": "network_connect",
        "process_name": "mstsc.exe",
        "dest_port": 3389,
        "dest_ip": "10.1.2.3"
      }
    },
    {
      "case_id": "authorized_winrm",
