foreach(kind IN ITEMS cache queue)
  if(kind STREQUAL "cache")
    set(owner test_local_evidence_cache_candidate)
  else()
    set(owner test_queue_recovery)
  endif()
  if(NOT TARGET ${owner})
    message(FATAL_ERROR "Real SQLite owner target is missing")
  endif()
  get_target_property(owner_sources ${owner} SOURCES)
  get_target_property(owner_dir ${owner} SOURCE_DIR)
  set(compat_sources "${CMAKE_CURRENT_LIST_DIR}/compat_${kind}.c")
  foreach(source IN LISTS owner_sources)
    if(NOT source MATCHES "(^|/)${owner}\\.c$")
      if(NOT IS_ABSOLUTE "${source}" AND NOT source MATCHES "^\\$<")
        set(source "${owner_dir}/${source}")
      endif()
      list(APPEND compat_sources "${source}")
    endif()
  endforeach()
  add_executable(storage_compat_${kind} ${compat_sources})
  target_include_directories(storage_compat_${kind} PRIVATE
    $<TARGET_PROPERTY:${owner},INCLUDE_DIRECTORIES> "${CMAKE_CURRENT_LIST_DIR}")
  target_compile_definitions(storage_compat_${kind} PRIVATE
    $<TARGET_PROPERTY:${owner},COMPILE_DEFINITIONS>
    "COMPAT_TEST_SOURCE=\"${owner_dir}/${owner}.c\""
    "COMPAT_SOURCE_COMMIT=\"${COMPAT_SOURCE_COMMIT}\"")
  target_compile_options(storage_compat_${kind} PRIVATE $<TARGET_PROPERTY:${owner},COMPILE_OPTIONS>)
  target_link_libraries(storage_compat_${kind} PRIVATE $<TARGET_PROPERTY:${owner},LINK_LIBRARIES>)
endforeach()
