#!/usr/bin/env bash
# ============================================================================
# [DEPRECATED — 参考实现，勿用于生产]
# 本脚本为早期 macOS-only 参考实现，且参数契约不匹配 agent（用 `--scope $2` 空格式，
# 而 agent 传 `--scope=value`），也不产出 `--out-file` 打包，端到端无法跑通。
# 正式实现见编译型二进制：tools/forensic_collector/main.c（CMake target forensic_collector）。
# 详见 docs/FORENSIC_COLLECTOR_SPEC.md「落地状态(v1.0.0 baseline)」。
# ============================================================================
# EDR Deep Forensic Collector (macOS/POSIX)
# 对标 CrowdStrike Falcon Forensics Collector
# ============================================================================
SCOPE="standard"
TIMEOUT=300
OUTPUT_DIR="/tmp/edr_forensic"
REASON=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --scope)      SCOPE="$2"; shift 2 ;;
    --timeout)    TIMEOUT="$2"; shift 2 ;;
    --output-dir) OUTPUT_DIR="$2"; shift 2 ;;
    --reason)     REASON="$2"; shift 2 ;;
    *)            echo "unknown: $1"; shift ;;
  esac
done

mkdir -p "$OUTPUT_DIR"

now_iso() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }

START_TS=$(now_iso)

echo "{\"collector\":\"edr-forensic-collector\",\"version\":\"1.0.0\",\"scope\":\"$SCOPE\",\"started_at\":\"$START_TS\",\"pid\":$$}"

# ----- Phase 1: System Info (all scopes) -----
echo "[phase] system_info"
HOSTNAME=$(hostname 2>/dev/null || echo "unknown")
KERNEL=$(uname -a 2>/dev/null || echo "unknown")
OS_VER=$(sw_vers 2>/dev/null || echo "macOS")
UPTIME=$(uptime 2>/dev/null || echo "unknown")
echo "{\"hostname\":\"$HOSTNAME\",\"kernel\":\"$KERNEL\",\"os_version\":\"$OS_VER\",\"uptime\":\"$UPTIME\",\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/system_info.json"
echo "{\"phase\":\"system_info\",\"hostname\":\"$HOSTNAME\",\"status\":\"ok\"}"

# ----- Phase 2: Process List (all scopes) -----
echo "[phase] process_list"
ps aux 2>/dev/null | head -500 > "$OUTPUT_DIR/processes.txt"
PCOUNT=$(wc -l < "$OUTPUT_DIR/processes.txt" 2>/dev/null | tr -d ' ')
echo "{\"count\":${PCOUNT:-0},\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/process_list.json"
echo "{\"phase\":\"process_list\",\"count\":${PCOUNT:-0},\"status\":\"ok\"}"

# ----- Phase 3: Network Connections (all scopes) -----
echo "[phase] network"
lsof -i -nP 2>/dev/null | head -500 > "$OUTPUT_DIR/network.txt" || true
netstat -an 2>/dev/null | head -500 >> "$OUTPUT_DIR/network.txt" || true
echo "{\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/network.json"
echo "{\"phase\":\"network\",\"status\":\"ok\"}"

# ----- Phase 4+: Standard + Deep -----
if [[ "$SCOPE" == "standard" || "$SCOPE" == "deep" ]]; then
  echo "[phase] startup_items"
  for d in /Library/LaunchDaemons /Library/LaunchAgents ~/Library/LaunchAgents; do
    ls -la "$d" 2>/dev/null >> "$OUTPUT_DIR/startup_items.txt" || true
  done
  crontab -l 2>/dev/null >> "$OUTPUT_DIR/startup_items.txt" || true
  echo "{\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/startup_items.json"
  echo "{\"phase\":\"startup_items\",\"status\":\"ok\"}"

  echo "[phase] services"
  launchctl list 2>/dev/null | head -200 > "$OUTPUT_DIR/services.txt" || true
  echo "{\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/services.json"
  echo "{\"phase\":\"services\",\"status\":\"ok\"}"

  echo "[phase] security"
  spctl --status 2>/dev/null > "$OUTPUT_DIR/security_settings.txt" || echo "unknown" > "$OUTPUT_DIR/security_settings.txt"
  csrutil status 2>/dev/null >> "$OUTPUT_DIR/security_settings.txt" || true
  echo "{\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/security.json"
  echo "{\"phase\":\"security\",\"status\":\"ok\"}"

  echo "[phase] cron_tasks"
  for u in /var/at/tabs/*; do
    [[ -f "$u" ]] || continue
    echo "=== $u ===" >> "$OUTPUT_DIR/cron_tasks.txt"
    cat "$u" 2>/dev/null >> "$OUTPUT_DIR/cron_tasks.txt" || true
  done
  echo "{\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/cron_tasks.json"
  echo "{\"phase\":\"cron_tasks\",\"status\":\"ok\"}"
fi

# ----- Phase 5+: Deep only -----
if [[ "$SCOPE" == "deep" ]]; then
  echo "[phase] user_accounts"
  dscl . -list /Users 2>/dev/null > "$OUTPUT_DIR/users.txt" || true
  echo "{\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/user_accounts.json"
  echo "{\"phase\":\"user_accounts\",\"status\":\"ok\"}"

  echo "[phase] shell_history"
  for hf in ~/.bash_history ~/.zsh_history /var/root/.bash_history /var/root/.zsh_history; do
    if [[ -f "$hf" ]]; then
      echo "=== $hf ===" >> "$OUTPUT_DIR/shell_history.txt"
      tail -500 "$hf" 2>/dev/null >> "$OUTPUT_DIR/shell_history.txt" || true
    fi
  done
  echo "{\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/shell_history.json"
  echo "{\"phase\":\"shell_history\",\"status\":\"ok\"}"

  echo "[phase] recent_files"
  find ~ -maxdepth 4 -type f -mtime -7 2>/dev/null | head -500 > "$OUTPUT_DIR/recent_files.txt" || true
  echo "{\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/recent_files.json"
  echo "{\"phase\":\"recent_files\",\"status\":\"ok\"}"

  echo "[phase] chrome_history"
  CH_DIR="$HOME/Library/Application Support/Google/Chrome/Default"
  if [[ -f "$CH_DIR/History" ]]; then
    cp "$CH_DIR/History" "$OUTPUT_DIR/chrome_history.sqlite" 2>/dev/null || true
  fi
  echo "{\"collected_at\":\"$(now_iso)\"}" > "$OUTPUT_DIR/chrome_history.json"
  echo "{\"phase\":\"chrome_history\",\"status\":\"ok\"}"
fi

END_TS=$(now_iso)

FILES=$(find "$OUTPUT_DIR" -maxdepth 1 -type f | wc -l | tr -d ' ')
echo "{\"phase\":\"complete\",\"started_at\":\"$START_TS\",\"finished_at\":\"$END_TS\",\"files\":${FILES:-0}}"

exit 0
