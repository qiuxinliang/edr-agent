#include <winver.h>
#include "../include/edr/windows_resource_ids.h"

#ifndef EDR_VERSION_MAJOR
#define EDR_VERSION_MAJOR 0
#define EDR_VERSION_MINOR 1
#define EDR_VERSION_PATCH 0
#define EDR_VERSION_STRING "0.1.0.0"
#endif

#ifndef EDR_VERSION_RESOURCE_ONLY
1 24 "FDSensor.manifest"
#endif

IDR_EDR_AGENT_UPDATE_SCRIPT RCDATA "../scripts/edr_agent_inplace_update.ps1"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EDR_VERSION_MAJOR,EDR_VERSION_MINOR,EDR_VERSION_PATCH,0
 PRODUCTVERSION EDR_VERSION_MAJOR,EDR_VERSION_MINOR,EDR_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "FDSecurity\0"
      VALUE "FileDescription", "FDSecurity Endpoint Agent\0"
      VALUE "FileVersion", EDR_VERSION_STRING "\0"
      VALUE "InternalName", "FDSensor\0"
      VALUE "OriginalFilename", "FDSensor.exe\0"
      VALUE "ProductName", "FDSecurity Agent\0"
      VALUE "ProductVersion", EDR_VERSION_STRING "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
