{
  "name": "edr-agent",
  "version-string": "1.0.0",
  "description": "EDR Agent — C runtime with vcpkg manifest for Windows client build dependencies.",
  "dependencies": [
    {
      "name": "curl",
      "features": [
        "http2"
      ]
    },
    "openssl",
    "pcre2",
    "sqlite3"
  ],
  "features": {
    "sqlite": {
      "description": "Enable SQLite-backed queues and AVE metadata tests.",
      "dependencies": [
        "sqlite3"
      ]
    },
    "yara": {
      "description": "Enable libyara-backed shellcode known-exploit rules.",
      "dependencies": [
        "yara",
        "pcre2"
      ]
    }
  }
}
